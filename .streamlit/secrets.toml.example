# Streamlit Secrets — Template for Streamlit Community Cloud
# Go to: https://share.streamlit.io → App → Settings → Secrets
# Paste the content below (without this comment) and fill in real values.

ANTHROPIC_API_KEY = "your-anthropic-api-key-here"
CLAUDE_MODEL      = "claude-sonnet-4-6"
ADMIN_PASSWORD    = "change-this-strong-password"
OFFICER_PASSWORD  = "change-this-strong-password"

# Optional: override storage paths on Streamlit Cloud
# DATABASE_PATH             = "data/campus.db"
# CHROMA_PERSIST_DIRECTORY  = "data/chroma"
# DOCUMENT_STORAGE_PATH     = "data/uploads"
