# ──────────────────────────────────────────────────────────────
# CampusCopilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a .env file containing real secrets to Git.
# ──────────────────────────────────────────────────────────────

# ── LLM Provider (Anthropic Claude) ───────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# ── Database ───────────────────────────────────────────────────
# Default: data/campus.db  (SQLite, local)
# For persistent hosting use an absolute path on a mounted volume:
# DATABASE_PATH=/mnt/data/campus.db
DATABASE_PATH=data/campus.db

# ── Vector Store (ChromaDB) ────────────────────────────────────
# Default: data/chroma  (local directory)
# For persistent hosting point to a mounted volume:
# CHROMA_PERSIST_DIRECTORY=/mnt/data/chroma
CHROMA_PERSIST_DIRECTORY=data/chroma

# ── PDF Upload Storage ─────────────────────────────────────────
# Default: data/uploads  (local directory)
# DOCUMENT_STORAGE_PATH=/mnt/data/uploads
DOCUMENT_STORAGE_PATH=data/uploads

# ── Default Credentials (change before going live!) ───────────
ADMIN_PASSWORD=admin123
OFFICER_PASSWORD=officer123
